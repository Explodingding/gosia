# =============================================================================
# Sekrety i konfiguracja agenta naborow
# =============================================================================
# Skopiuj ten plik do `.env` i wypelnij prawdziwymi wartosciami.
# `.env` JEST w .gitignore - nigdy nie commitujemy go do repo.
# Na produkcji (GitHub Actions) te same nazwy laduja jako Secrets.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Znajdziesz w Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# --- OpenAI -----------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# Model do streszczen i tagowania - tani i wystarczajaco dobry
OPENAI_MODEL=gpt-4o-mini

# --- Resend (mail) ----------------------------------------------------------
# https://resend.com/api-keys (darmowy plan: 100 maili/dzien)
RESEND_API_KEY=re_...
# Adres "Od" musi byc na zweryfikowanej domenie w Resend.
# Dla testow mozna uzywac onboarding@resend.dev (ograniczenia).
MAIL_FROM=Agent Naborow <agent@inwestycjepomorze.pl>
# Adres docelowy
MAIL_TO=gosiagrzyska@gmail.com
# Opcjonalnie: kopia do Ciebie
MAIL_CC=

# --- Google Sheets (panel akceptacji) ---------------------------------------
# JSON klucza service accountu, najlepiej JEDNA linia (json -c).
# W GitHub Actions wklejasz wielolinijkowy JSON, lokalnie jedna linia.
GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# ID arkusza Google (z URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit)
GOOGLE_SHEET_ID=

# --- Konfiguracja runa ------------------------------------------------------
# Czy wysylac mail nawet gdy 0 nowych naborow (yes/no)
MAIL_ALWAYS=no
# Tryb dry-run: nie zapisuje do bazy ani nie wysyla maili (yes/no)
DRY_RUN=no
# Limit naborow do enrichmentu w jednym runie (chroni przed przekroczeniem budzetu)
MAX_ENRICH_PER_RUN=80
# Strefa czasowa do wyswietlania dat
TZ=Europe/Warsaw

# --- Logowanie --------------------------------------------------------------
LOG_LEVEL=INFO
